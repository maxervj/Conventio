{% extends 'base.html.twig' %}

{% block title %}Modifier {{ level.levelName }}{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-8">

    {# Fil d'Ariane #}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{{ path('app_level_index') }}" class="hover:text-blue-600 transition">Classes</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-gray-900 font-medium">Modifier</span>
    </nav>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="flex items-center gap-3 mb-6 pb-5 border-b border-gray-100">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-xl font-bold text-gray-900">Modifier la classe</h1>
                <p class="text-sm text-gray-500 mt-0.5">{{ level.levelName }}</p>
            </div>
        </div>

        {{ include('level/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
    </div>

    {# Zone de suppression #}
    <div class="mt-6 bg-red-50 border border-red-200 rounded-xl p-5">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-sm font-semibold text-red-800">Supprimer cette classe</p>
                <p class="text-xs text-red-600 mt-1">Cette action est irréversible. Les étudiants rattachés perdront cette classe.</p>
            </div>
            <form method="post" action="{{ path('app_level_delete', {'id': level.id}) }}"
                  onsubmit="return confirm('Supprimer définitivement la classe « {{ level.levelName }} » ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ level.id) }}">
                <button type="submit"
                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Supprimer
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
