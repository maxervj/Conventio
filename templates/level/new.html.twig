{% extends 'base.html.twig' %}

{% block title %}Nouvelle classe{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-8">

    {# Fil d'Ariane #}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{{ path('app_level_index') }}" class="hover:text-blue-600 transition">Classes</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-gray-900 font-medium">Nouvelle classe</span>
    </nav>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="flex items-center gap-3 mb-6 pb-5 border-b border-gray-100">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <h1 class="text-xl font-bold text-gray-900">Créer une nouvelle classe</h1>
        </div>

        {{ include('level/_form.html.twig', {'button_label': 'Créer la classe'}) }}
    </div>
</div>
{% endblock %}
