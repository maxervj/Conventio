{% extends "base.html.twig" %}

{% block title %}Ma convention de stage - Conventio {% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Retour -->
    <div class="mb-6">
        <a href="{{ path('convention_index') }}" class="inline-flex items-center text-blue-600 hover:text-blue-700 transition">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Retour à mes conventions
        </a>
    </div>

    <!-- En-tête -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">
            Ma convention de stage
        </h1>
        <div class="flex items-center gap-3 mb-4">
            {% if convention.isDraft() %}
                <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                    🔄 Brouillon
                </span>
            {% elseif convention.isPendingValidation() %}
                <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                    ⏳ En attente de validation du professeur
                </span>
            {% elseif convention.isValidated() %}
                <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                    ✓ Validée
                </span>
            {% else %}
                <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                    {{ convention.getStatus() }}
                </span>
            {% endif %}
            {% if convention.student.formation %}
                <span class="text-gray-600 font-medium">{{ convention.student.formation.libelle }}</span>
            {% endif %}
        </div>
    </div>

    <!-- Alertes -->
    {% for message in app.flashes('success') %}
        <div class="mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-700 rounded">
            <div class="flex items-center">
                <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                </svg>
                {{ message }}
            </div>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded">
            <div class="flex items-center">
                <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"/>
                </svg>
                {{ message }}
            </div>
        </div>
    {% endfor %}

    <!-- Contenu principal -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Section principale -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Informations personnelles -->
            <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">👤 Mes informations</h2>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Prénom</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">{{ convention.student.firstName }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Nom</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">{{ convention.student.lastName }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Email</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">{{ convention.student.email }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Formation</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">
                            {% if convention.student.formation %}
                                {{ convention.student.formation.libelle }}
                            {% else %}
                                <span class="text-gray-400">Non renseignée</span>
                            {% endif %}
                        </p>
                    </div>
                    {% if convention.referentProfessor %}
                        <div class="col-span-2">
                            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Professeur référent</p>
                            <p class="text-lg font-medium text-gray-900 mt-1">{{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Informations de la collecte (InternshipCompanyInfo) -->
            {% if convention.companyInfo %}
                <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">🏢 Informations de ma collecte</h2>

                    <!-- Entreprise -->
                    <div class="mb-6 pb-6 border-b border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Entreprise</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Nom</p>
                                <p class="text-base font-medium text-gray-900 mt-1">{{ convention.companyInfo.companyName }}</p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">SIRET</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.siret %}
                                        {{ convention.companyInfo.siret }}
                                    {% else %}
                                        <span class="text-gray-400">Non renseigné</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div class="col-span-2">
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Adresse</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.address %}
                                        {{ convention.companyInfo.address }}
                                        {% if convention.companyInfo.addressComplement %}<br>{{ convention.companyInfo.addressComplement }}{% endif %}
                                        <br>{{ convention.companyInfo.postalCode }} {{ convention.companyInfo.city }}
                                        {% if convention.companyInfo.country %}<br>{{ convention.companyInfo.country }}{% endif %}
                                    {% else %}
                                        <span class="text-gray-400">Non renseignée</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Contact responsable -->
                    <div class="mb-6 pb-6 border-b border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">👤 Responsable de stage (Maître de stage)</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Nom</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.responsibleLastName %}
                                        {{ convention.companyInfo.responsibleLastName }}
                                    {% else %}
                                        <span class="text-gray-400">Non renseigné</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Prénom</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.responsibleFirstName %}
                                        {{ convention.companyInfo.responsibleFirstName }}
                                    {% else %}
                                        <span class="text-gray-400">Non renseigné</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Fonction</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.responsibleFunction %}
                                        {{ convention.companyInfo.responsibleFunction }}
                                    {% else %}
                                        <span class="text-gray-400">Non renseignée</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Email</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.email %}
                                        <a href="mailto:{{ convention.companyInfo.email }}" class="text-blue-600 hover:text-blue-700">
                                            {{ convention.companyInfo.email }}
                                        </a>
                                    {% else %}
                                        <span class="text-gray-400">Non renseigné</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Dates et période de stage -->
                    <div class="mb-6 pb-6 border-b border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">📅 Période de stage</h3>
                        {% if convention.student and convention.student.level and convention.student.level.internshipDate %}
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Date de début</p>
                                    <p class="text-base font-medium text-gray-900 mt-1">
                    <span class="inline-block px-3 py-1 bg-indigo-50 text-indigo-900 rounded font-semibold">
                        {{ convention.student.level.internshipDate.startDate|date('d/m/Y') }}
                    </span>
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Date de fin</p>
                                    <p class="text-base font-medium text-gray-900 mt-1">
                    <span class="inline-block px-3 py-1 bg-indigo-50 text-indigo-900 rounded font-semibold">
                        {{ convention.student.level.internshipDate.endDate|date('d/m/Y') }}
                    </span>
                                    </p>
                                </div>
                            </div>
                        {% else %}
                            <div class="bg-yellow-50 rounded-lg border-l-4 border-yellow-400 p-4 text-yellow-700">
                                <p class="text-sm">⚠️ Aucune date paramétrée pour votre classe.</p>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Sujet et missions -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">📝 Activités professionnelles prévues</h3>
                        <div>
                            <p class="text-base font-medium text-gray-900 bg-gray-50 p-4 rounded-lg">
                                {% if convention.companyInfo.plannedActivities %}
                                    {{ convention.companyInfo.plannedActivities }}
                                {% else %}
                                    <span class="text-gray-400">Non renseigné</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="bg-yellow-50 rounded-lg border-l-4 border-yellow-400 p-4 text-yellow-700">
                    <p>⚠️ Aucune information de collecte disponible pour cette convention.</p>
                    <p class="text-sm mt-2">Vous devez d'abord compléter votre collecte pour pouvoir demander la validation à votre professeur référent.</p>
                </div>
            {% endif %}
        </div>

        <!-- Barre latérale - Actions -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 sticky top-24">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Actions</h3>

                <div class="space-y-3">
                    <!-- Bouton Générer PDF -->
                    {% if convention.documentPath or convention.isDraft() or convention.isPendingValidation() %}
                        <a href="{{ path('admin_convention_generate_pdf', {'id': convention.id}) }}"
                           target="_blank"
                           class="block w-full px-4 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-center font-semibold no-underline">
                            <svg class="h-5 w-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8m0 8l-6-4m6 4l6-4"/>
                            </svg>
                            Générer le PDF
                        </a>
                    {% endif %}

                    <!-- Bouton Demander la validation (Brouillon) -->
                    {% if convention.isDraft() and convention.companyInfo %}
                        <form method="POST" action="{{ path('convention_request_validation', {'id': convention.id}) }}" class="w-full">
                            <input type="hidden" name="_token" value="{{ csrf_token('request_validation_' ~ convention.id) }}">
                            <button type="submit"
                                    class="w-full px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold flex items-center justify-center"
                                    onclick="return confirm('Êtes-vous sûr de vouloir soumettre votre convention à la validation de votre professeur référent ?')">
                                <svg class="h-5 w-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8m0 8l-6-4m6 4l6-4"/>
                                </svg>
                                Demander la validation
                            </button>
                        </form>

                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                            <p class="text-sm text-blue-800">
                                <strong>💡 Conseil</strong><br>
                                Assurez-vous que tous les détails de votre collecte sont corrects avant de soumettre à validation.
                            </p>
                        </div>
                    {% endif %}

                    <!-- État de la validation (En attente) -->
                    {% if convention.isPendingValidation() %}
                        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                            <div class="flex items-start mb-2">
                                <svg class="h-5 w-5 text-yellow-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"/>
                                </svg>
                                <strong class="text-yellow-800">En attente de validation</strong>
                            </div>
                            <p class="text-sm text-yellow-700">
                                Votre demande a été envoyée à {{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}.<br>
                                <br>
                                Vous recevrez un email dès que votre convention aura été validée.
                            </p>
                        </div>
                    {% endif %}

                    <!-- État validée -->
                    {% if convention.isValidated() %}
                        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                            <div class="flex items-center mb-2">
                                <svg class="h-5 w-5 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                                </svg>
                                <strong class="text-green-800">Convention validée !</strong>
                            </div>
                            <p class="text-sm text-green-700">
                                Votre convention a été approuvée par {{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }} le {{ convention.validatedAt|date('d/m/Y à H:i') }}.
                            </p>
                        </div>
                    {% endif %}

                    <!-- Bouton Télécharger -->
                    {% if convention.documentPath %}
                        <a href="{{ convention.documentPath }}"
                           class="block w-full px-4 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition text-center font-semibold no-underline">
                            <svg class="h-5 w-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                            </svg>
                            Télécharger le document
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

