{% extends 'base.html.twig' %}

{% block title %}Convention — Conventio{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">

        {# Back link #}
        <a href="{{ path('convention_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 hover:text-indigo-500 mb-6 group">
            <svg class="h-4 w-4 transition group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour aux conventions
        </a>

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-lg {% if type == 'success' %}bg-green-50 border border-green-200 text-green-800{% elseif type == 'error' %}bg-red-50 border border-red-200 text-red-800{% else %}bg-blue-50 border border-blue-200 text-blue-800{% endif %} p-4">
                    <p class="text-sm font-medium">{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}

        {# Main card #}
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">

            {# Header #}
            <div class="px-6 py-4 bg-gradient-to-r from-indigo-600 to-purple-600">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-2xl font-bold text-white">Convention de stage</h1>
                        <p class="text-indigo-100 text-sm mt-1">Créée le {{ convention.createdAt|date('d/m/Y à H:i') }}</p>
                    </div>
                    <div>
                        {% set statusLabel = {
                            'draft': 'Brouillon',
                            'pending_validation': 'En attente de validation',
                            'validated': 'Validée',
                            'pending_signature': 'En attente de signature',
                            'signed': 'Signée',
                            'completed': 'Complétée',
                            'cancelled': 'Annulée'
                        } %}
                        {% set statusColor = {
                            'draft': 'bg-gray-100 text-gray-700',
                            'pending_validation': 'bg-amber-100 text-amber-700',
                            'validated': 'bg-green-100 text-green-700',
                            'pending_signature': 'bg-blue-100 text-blue-700',
                            'signed': 'bg-indigo-100 text-indigo-700',
                            'completed': 'bg-purple-100 text-purple-700',
                            'cancelled': 'bg-red-100 text-red-700'
                        } %}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium {{ statusColor[convention.status]|default('bg-gray-100 text-gray-700') }}">
                            {{ statusLabel[convention.status]|default(convention.status) }}
                        </span>
                    </div>
                </div>
            </div>

            {# Content #}
            <div class="px-6 py-8">

                {# Student Information #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                        <div class="flex items-start">
                            <div class="h-10 w-10 flex-shrink-0 rounded-full bg-indigo-100 flex items-center justify-center">
                                <svg class="h-6 w-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            <div class="ml-4">
                                <p class="font-semibold text-gray-900">{{ convention.student.firstName }} {{ convention.student.lastName }}</p>
                                <p class="text-xs text-gray-500 mt-0.5">{{ convention.student.email }}</p>
                                {% if convention.student.levels|length > 0 %}
                                    <p class="text-xs text-blue-600 mt-1">{{ convention.student.levels|map(l => l.levelName)|join(', ') }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Professeur référent #}
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                        {% if convention.referentProfessor %}
                            <div class="flex items-start">
                                <div class="h-10 w-10 flex-shrink-0 rounded-full bg-purple-100 flex items-center justify-center">
                                    <svg class="h-6 w-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                </div>
                                <div class="ml-4">
                                    <p class="font-semibold text-gray-900">{{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Professeur référent</p>
                                    <p class="text-xs text-purple-600 mt-1">{{ convention.referentProfessor.email }}</p>
                                </div>
                            </div>
                        {% else %}
                            <div class="text-gray-500 text-sm">
                                <p class="font-semibold text-gray-900">Aucun professeur référent</p>
                                <p class="text-xs text-gray-500 mt-0.5">À assigner</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Company Information #}
                {% if convention.companyInfo %}
                    <div class="bg-gradient-to-br from-blue-50 to-cyan-50 rounded-2xl border border-blue-100 p-6 mb-8">
                        <h2 class="text-lg font-bold text-gray-900 mb-4">Entreprise d'accueil</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <p class="text-xs text-gray-600 font-semibold">Entreprise</p>
                                <p class="text-sm text-gray-900 mt-1">{{ convention.companyInfo.companyName }}</p>
                            </div>
                            {% if convention.companyInfo.city %}
                                <div>
                                    <p class="text-xs text-gray-600 font-semibold">Lieu</p>
                                    <p class="text-sm text-gray-900 mt-1">{{ convention.companyInfo.city }}{% if convention.companyInfo.country %}, {{ convention.companyInfo.country }}{% endif %}</p>
                                </div>
                            {% endif %}
                            {% if convention.companyInfo.internshipStartDate and convention.companyInfo.internshipEndDate %}
                                <div>
                                    <p class="text-xs text-gray-600 font-semibold">Période de stage</p>
                                    <p class="text-sm text-gray-900 mt-1">{{ convention.companyInfo.internshipStartDate|date('d/m/Y') }} → {{ convention.companyInfo.internshipEndDate|date('d/m/Y') }}</p>
                                </div>
                            {% endif %}
                            {% if convention.companyInfo.supervisorFirstName %}
                                <div>
                                    <p class="text-xs text-gray-600 font-semibold">Maître de stage</p>
                                    <p class="text-sm text-gray-900 mt-1">{{ convention.companyInfo.supervisorFirstName }} {{ convention.companyInfo.supervisorLastName }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {# Validation Notes #}
                {% if convention.validationNotes %}
                    <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl border border-green-100 p-6 mb-8">
                        <h2 class="text-lg font-bold text-gray-900 mb-2">Notes de validation</h2>
                        <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ convention.validationNotes }}</p>
                    </div>
                {% endif %}

                {# Rejection Reason #}
                {% if convention.rejectionReason %}
                    <div class="bg-gradient-to-br from-red-50 to-pink-50 rounded-2xl border border-red-100 p-6 mb-8">
                        <h2 class="text-lg font-bold text-gray-900 mb-2">Motif de rejet</h2>
                        <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ convention.rejectionReason }}</p>
                    </div>
                {% endif %}

            </div>
        </div>

        {# Action buttons #}
        <div class="mt-8">

            {# For Student - Request Validation #}
            {% if isStudent and convention.isDraft() and convention.referentProfessor %}
                <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 p-6">
                    <h2 class="text-sm font-bold text-gray-700 mb-2">Soumettre pour validation</h2>
                    <p class="text-sm text-gray-500 mb-4">
                        Envoyez votre convention à <strong>{{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}</strong> pour validation.
                        Un email lui sera automatiquement envoyé avec un lien vers cette convention.
                    </p>
                    <form method="POST" action="{{ path('convention_request_validation', {id: convention.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('request_validation_' ~ convention.id) }}">
                        <button type="submit"
                                class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8m0 8l-9-2m9 2l9-2"/>
                            </svg>
                            Soumettre pour validation
                        </button>
                    </form>
                </div>
            {% endif %}

            {# For Professor - Validate Convention #}
            {% if isReferentProfessor and convention.isPendingValidation() %}
                <div class="bg-white rounded-2xl shadow-sm border border-green-100 p-6">
                    <h2 class="text-sm font-bold text-gray-700 mb-2">Valider la convention</h2>
                    <p class="text-sm text-gray-500 mb-4">
                        Vous êtes le professeur référent de cette convention. Vous pouvez la valider si le sujet et les conditions de stage sont appropriés.
                    </p>
                    <form method="POST" action="{{ path('convention_validate', {id: convention.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('validate_convention_' ~ convention.id) }}">
                        <button type="submit"
                                class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors">
                            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            Valider la convention
                        </button>
                    </form>
                </div>
            {% endif %}

        </div>

    </div>
</div>
{% endblock %}

