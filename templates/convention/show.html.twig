{% extends 'base.html.twig' %}

{% block title %}Convention — Conventio{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">

        {# Back link #}
        <a href="{{ path('convention_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 hover:text-indigo-500 mb-6 group">
            <svg class="h-4 w-4 transition group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour aux conventions
        </a>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 p-4 rounded-xl border-l-4 {{ label == 'error' ? 'bg-red-50 border-red-500 text-red-700' : 'bg-green-50 border-green-500 text-green-700' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Status badge mapping #}
        {% set statusLabel = {
            'draft': 'Brouillon',
            'pending_validation': 'En attente de validation',
            'validated': 'Validée',
            'pending_signature': 'En attente de signature',
            'signed': 'Signée',
            'completed': 'Complétée',
            'cancelled': 'Annulée'
        } %}
        {% set statusColor = {
            'draft': 'bg-gray-100 text-gray-700 border-gray-200',
            'pending_validation': 'bg-amber-100 text-amber-700 border-amber-200',
            'validated': 'bg-green-100 text-green-700 border-green-200',
            'pending_signature': 'bg-blue-100 text-blue-700 border-blue-200',
            'signed': 'bg-indigo-100 text-indigo-700 border-indigo-200',
            'completed': 'bg-purple-100 text-purple-700 border-purple-200',
            'cancelled': 'bg-red-100 text-red-700 border-red-200'
        } %}

        {# Header card #}
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
            <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center shadow-lg flex-shrink-0">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-2xl font-extrabold text-gray-900">Convention de stage</h1>
                        <p class="text-sm text-gray-500 mt-0.5">Créée le {{ convention.createdAt|date('d/m/Y à H:i') }}</p>
                    </div>
                </div>
                <span class="px-3 py-1.5 rounded-full text-sm font-semibold border {{ statusColor[convention.status] ?? 'bg-gray-100 text-gray-700 border-gray-200' }} flex-shrink-0">
                    {{ statusLabel[convention.status] ?? convention.status }}
                </span>
            </div>
        </div>

        {# Parties #}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            {# Étudiant #}
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Étudiant</h2>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-semibold text-gray-900">{{ convention.student.firstName }} {{ convention.student.lastName }}</p>
                        <p class="text-xs text-gray-500">{{ convention.student.email }}</p>
                        {% if convention.student.levels|length > 0 %}
                            <p class="text-xs text-blue-600 mt-0.5">{{ convention.student.levels|map(l => l.levelName)|join(', ') }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Professeur référent #}
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Professeur référent</h2>
                {% if convention.referentProfessor %}
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-900">{{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}</p>
                            <p class="text-xs text-gray-500">{{ convention.referentProfessor.email }}</p>
                        </div>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-400 italic">Aucun professeur référent assigné</p>
                {% endif %}
            </div>
        </div>

        {# Informations entreprise #}
        {% if convention.companyInfo %}
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
                <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                    Entreprise d'accueil
                </h2>

                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Entreprise</dt>
                        <dd class="mt-0.5 text-sm font-semibold text-gray-900">{{ convention.companyInfo.companyName }}</dd>
                    </div>
                    {% if convention.companyInfo.city %}
                        <div>
                            <dt class="text-xs font-medium text-gray-400">Ville</dt>
                            <dd class="mt-0.5 text-sm text-gray-900">{{ convention.companyInfo.city }}{% if convention.companyInfo.country %}, {{ convention.companyInfo.country }}{% endif %}</dd>
                        </div>
                    {% endif %}
                    {% if convention.companyInfo.supervisorLastName %}
                        <div>
                            <dt class="text-xs font-medium text-gray-400">Maître de stage</dt>
                            <dd class="mt-0.5 text-sm text-gray-900">{{ convention.companyInfo.supervisorFirstName }} {{ convention.companyInfo.supervisorLastName }}</dd>
                        </div>
                    {% endif %}
                    {% if convention.companyInfo.supervisorFunction %}
                        <div>
                            <dt class="text-xs font-medium text-gray-400">Fonction du maître de stage</dt>
                            <dd class="mt-0.5 text-sm text-gray-900">{{ convention.companyInfo.supervisorFunction }}</dd>
                        </div>
                    {% endif %}
                    {% if convention.companyInfo.internshipStartDate %}
                        <div>
                            <dt class="text-xs font-medium text-gray-400">Début du stage</dt>
                            <dd class="mt-0.5 text-sm text-gray-900">{{ convention.companyInfo.internshipStartDate|date('d/m/Y') }}</dd>
                        </div>
                    {% endif %}
                    {% if convention.companyInfo.internshipEndDate %}
                        <div>
                            <dt class="text-xs font-medium text-gray-400">Fin du stage</dt>
                            <dd class="mt-0.5 text-sm text-gray-900">{{ convention.companyInfo.internshipEndDate|date('d/m/Y') }}</dd>
                        </div>
                    {% endif %}
                </dl>

                {% if convention.companyInfo.plannedActivities %}
                    <div class="mt-4 pt-4 border-t border-gray-100">
                        <dt class="text-xs font-medium text-gray-400 mb-1">Activités prévues</dt>
                        <dd class="text-sm text-gray-700 leading-relaxed">{{ convention.companyInfo.plannedActivities|nl2br }}</dd>
                    </div>
                {% endif %}
            </div>
        {% else %}
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mb-6 flex items-center gap-3">
                <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.962-.833-2.732 0L3.07 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                </svg>
                <p class="text-sm text-amber-700">Les informations entreprise n'ont pas encore été renseignées.</p>
            </div>
        {% endif %}

        {# Barre d'avancement #}
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
            <h2 class="text-sm font-bold text-gray-700 mb-4">Avancement</h2>
            <div class="flex items-center gap-0">
                {% set steps = [
                    {key: 'draft', label: 'Brouillon'},
                    {key: 'pending_validation', label: 'Demande envoyée'},
                    {key: 'validated', label: 'Validée'},
                    {key: 'pending_signature', label: 'Signature'},
                    {key: 'signed', label: 'Signée'},
                    {key: 'completed', label: 'Terminée'},
                ] %}
                {% set statusOrder = {'draft': 0, 'pending_validation': 1, 'validated': 2, 'pending_signature': 3, 'signed': 4, 'completed': 5} %}
                {% set currentOrder = statusOrder[convention.status] ?? 0 %}

                {% for i, step in steps %}
                    {% set stepOrder = statusOrder[step.key] ?? 0 %}
                    {% set isDone = currentOrder > stepOrder %}
                    {% set isCurrent = currentOrder == stepOrder %}

                    <div class="flex items-center {{ not loop.last ? 'flex-1' : '' }}">
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center border-2 transition-all
                                {{ isDone ? 'bg-green-500 border-green-500' : (isCurrent ? 'bg-indigo-600 border-indigo-600' : 'bg-white border-gray-300') }}">
                                {% if isDone %}
                                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                    </svg>
                                {% elseif isCurrent %}
                                    <div class="w-3 h-3 rounded-full bg-white"></div>
                                {% endif %}
                            </div>
                            <p class="text-xs font-medium mt-1.5 text-center w-16 leading-tight
                                {{ isDone ? 'text-green-600' : (isCurrent ? 'text-indigo-700' : 'text-gray-400') }}">
                                {{ step.label }}
                            </p>
                        </div>
                        {% if not loop.last %}
                            <div class="flex-1 h-0.5 mb-5 mx-1 {{ isDone ? 'bg-green-400' : 'bg-gray-200' }}"></div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

        {# Actions et messages d'état #}
        <div class="space-y-4">

            {# Admin : actions #}
            {% if is_granted('ROLE_ADMIN') %}
                <div class="bg-white rounded-2xl shadow-sm border border-red-100 p-6">
                    <h2 class="text-sm font-bold text-gray-700 mb-4">Actions administrateur</h2>
                    <div class="flex flex-wrap items-center gap-3">

                        {# Relancer YouSign si la validation a eu lieu mais le déclenchement automatique a échoué #}
                        {% if convention.isValidated() and not convention.yousignRequestId %}
                            <form method="POST" action="{{ path('convention_approve', {id: convention.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve_convention_' ~ convention.id) }}">
                                <button type="submit"
                                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 shadow-md transition-all duration-200">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                    </svg>
                                    Envoyer pour signature (YouSign)
                                </button>
                            </form>
                        {% endif %}

                        {# Générer ou télécharger PDF #}
                        {% if convention.status != 'draft' %}
                            <a href="{{ path('convention_pdf', {id: convention.id}) }}"
                               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 shadow-md transition-all duration-200">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                                {% if convention.isSigned() %}Télécharger la convention signée{% else %}Générer PDF{% endif %}
                            </a>
                        {% endif %}

                        {# Messages contextuels #}
                        {% if convention.isPendingSignature() %}
                            <p class="text-xs text-blue-600 italic w-full mt-1">
                                En attente de signature par les 3 parties via YouSign. Les emails ont été envoyés automatiquement.
                            </p>
                        {% elseif convention.isValidated() and convention.yousignRequestId %}
                            <p class="text-xs text-green-600 italic w-full mt-1">
                                La demande de signature a été envoyée à YouSign.
                            </p>
                        {% elseif not convention.isValidated() and not convention.isSigned() and not convention.isPendingSignature() and not convention.isCompleted() %}
                            <p class="text-xs text-gray-400 italic w-full mt-1">
                                En attente de validation par le professeur référent.
                            </p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# Étudiant : demande de validation #}
            {% if isStudent and convention.isDraft() and convention.referentProfessor %}
                <div class="bg-white rounded-2xl shadow-sm border border-indigo-100 p-6">
                    <h2 class="text-sm font-bold text-gray-700 mb-2">Soumettre pour validation</h2>
                    <p class="text-sm text-gray-500 mb-4">
                        Envoyez votre convention à <strong>{{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}</strong> pour validation.
                        Un email lui sera automatiquement envoyé avec un lien vers cette convention.
                    </p>
                    <form method="POST" action="{{ path('convention_request_validation', {id: convention.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('request_validation_' ~ convention.id) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 shadow-md hover:shadow-lg transition-all duration-200">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                            </svg>
                            Demander la validation
                        </button>
                    </form>
                </div>
            {% endif %}

            {# Étudiant : convention en attente de validation #}
            {% if isStudent and convention.isPendingValidation() %}
                <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-amber-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-amber-800">En attente de validation</p>
                        <p class="text-xs text-amber-600 mt-0.5">
                            Votre demande a été envoyée à {{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}.
                            Vous serez notifié par email dès que la convention sera validée.
                        </p>
                    </div>
                </div>
            {% endif %}

            {# Professeur référent : bouton valider #}
            {% if isReferentProfessor and convention.isPendingValidation() %}
                <div class="bg-white rounded-2xl shadow-sm border border-green-100 p-6">
                    <h2 class="text-sm font-bold text-gray-700 mb-2">Valider la convention</h2>
                    <p class="text-sm text-gray-500 mb-4">
                        En validant cette convention, vous confirmez que le sujet de stage proposé par
                        <strong>{{ convention.student.firstName }} {{ convention.student.lastName }}</strong>
                        {% if convention.companyInfo %}chez <strong>{{ convention.companyInfo.companyName }}</strong>{% endif %}
                        est conforme aux exigences pédagogiques.
                        <span class="text-indigo-600 font-medium">La signature électronique sera automatiquement envoyée aux 3 parties via YouSign.</span>
                    </p>
                    <div class="flex items-center gap-3">
                        <form method="POST" action="{{ path('convention_validate', {id: convention.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('validate_convention_' ~ convention.id) }}">
                            <button type="submit"
                                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 shadow-md hover:shadow-lg transition-all duration-200">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                </svg>
                                Valider et envoyer pour signature
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}

            {# Convention validée : message de succès + attente YouSign #}
            {% if convention.isValidated() %}
                <div class="bg-green-50 border border-green-200 rounded-2xl p-5 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-green-800">Convention validée par le professeur</p>
                        <p class="text-xs text-green-600 mt-0.5">
                            Validée le {{ convention.validatedAt|date('d/m/Y à H:i') }} par {{ convention.referentProfessor ? convention.referentProfessor.firstName ~ ' ' ~ convention.referentProfessor.lastName : 'le professeur référent' }}.
                            {% if not convention.yousignRequestId %}
                                La signature électronique doit être envoyée.
                            {% else %}
                                La demande de signature a été transmise à YouSign.
                            {% endif %}
                        </p>
                    </div>
                </div>
            {% endif %}

            {# En attente de signature YouSign (pour tous les rôles) #}
            {% if convention.isPendingSignature() %}
                <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5 flex items-start gap-3">
                    <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg class="w-5 h-5 text-blue-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-blue-800">En attente de signature électronique</p>
                        <p class="text-xs text-blue-600 mt-0.5">
                            Les 3 parties ont reçu un email YouSign avec leur lien de signature personnalisé :
                        </p>
                        <ul class="text-xs text-blue-600 mt-2 space-y-1 list-disc list-inside">
                            <li>L'étudiant — {{ convention.student.firstName }} {{ convention.student.lastName }}</li>
                            {% if convention.companyInfo %}
                                <li>L'entreprise — {{ convention.companyInfo.companyName }}</li>
                            {% endif %}
                            <li>L'établissement scolaire</li>
                        </ul>
                        <p class="text-xs text-blue-500 mt-2 italic">La convention sera générée automatiquement dès que les 3 parties auront signé.</p>
                    </div>
                </div>
            {% endif %}

            {# Convention signée (toutes les parties ont signé) #}
            {% if convention.isSigned() %}
                <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-5 flex items-start gap-3">
                    <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-indigo-800">Convention signée par toutes les parties</p>
                        {% if convention.signedAt %}
                            <p class="text-xs text-indigo-600 mt-0.5">Signée le {{ convention.signedAt|date('d/m/Y à H:i') }}.</p>
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <p class="text-xs text-indigo-500 mt-1">Vous pouvez télécharger la convention signée via le bouton ci-dessus.</p>
                        {% else %}
                            <p class="text-xs text-indigo-500 mt-1">La convention officielle signée est disponible auprès de votre établissement.</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# Convention annulée #}
            {% if convention.isCancelled() %}
                <div class="bg-red-50 border border-red-200 rounded-2xl p-5 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-red-800">Convention annulée</p>
                        <p class="text-xs text-red-600 mt-0.5">
                            {% if convention.rejectionReason %}
                                Motif : {{ convention.rejectionReason }}
                            {% else %}
                                La procédure de signature a été annulée ou a expiré. Contactez votre établissement pour plus d'informations.
                            {% endif %}
                        </p>
                    </div>
                </div>
            {% endif %}

            {# Convention complétée #}
            {% if convention.isCompleted() %}
                <div class="bg-purple-50 border border-purple-200 rounded-2xl p-5 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-purple-800">Convention complétée</p>
                        {% if convention.completedAt %}
                            <p class="text-xs text-purple-600 mt-0.5">Archivée le {{ convention.completedAt|date('d/m/Y à H:i') }}.</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

        </div>

    </div>
</div>
{% endblock %}
