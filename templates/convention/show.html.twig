{% extends "../base.html.twig" %}

{% block title %}Détail de la demande - Admin{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Retour -->
    <div class="mb-6">
        <a href="{{ path('admin_convention_list') }}" class="inline-flex items-center text-blue-600 hover:text-blue-700 transition">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Retour aux demandes
        </a>
    </div>

    <!-- En-tête -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">
            {{ convention.student.firstName }} {{ convention.student.lastName }}
        </h1>
        <div class="flex items-center gap-3 mb-4">
            <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                En attente de validation
            </span>
            {% if convention.student.formation %}
                <span class="text-gray-600">{{ convention.student.formation.libelle }}</span>
            {% endif %}
        </div>
    </div>

    <!-- Alertes -->
    {% for message in app.flashes('success') %}
        <div class="mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-700">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700">
            {{ message }}
        </div>
    {% endfor %}

    <!-- Contenu principal -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Section principale -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Informations de l'étudiant -->
            <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Informations de l'étudiant</h2>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Prénom</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">{{ convention.student.firstName }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Nom</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">{{ convention.student.lastName }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Email</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">{{ convention.student.email }}</p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Formation</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">
                            {% if convention.student.formation %}
                                {{ convention.student.formation.libelle }}
                            {% else %}
                                <span class="text-gray-400">Non renseignée</span>
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Informations de la collecte (InternshipCompanyInfo) -->
            {% if convention.companyInfo %}
                <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">Informations de la collecte</h2>

                    <!-- Entreprise -->
                    <div class="mb-6 pb-6 border-b border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Entreprise</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Nom</p>
                                <p class="text-base font-medium text-gray-900 mt-1">{{ convention.companyInfo.companyName }}</p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">SIRET</p>
                                <p class="text-base font-medium text-gray-900 mt-1">{{ convention.companyInfo.siret|default('Non renseigné') }}</p>
                            </div>
                            <div class="col-span-2">
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Adresse</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.address %}
                                        {{ convention.companyInfo.address }}
                                        {% if convention.companyInfo.addressComplement %}<br>{{ convention.companyInfo.addressComplement }}{% endif %}
                                        <br>{{ convention.companyInfo.postalCode }} {{ convention.companyInfo.city }}
                                        {% if convention.companyInfo.country %}<br>{{ convention.companyInfo.country }}{% endif %}
                                    {% else %}
                                        <span class="text-gray-400">Non renseignée</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Contact responsable -->
                    <div class="mb-6 pb-6 border-b border-gray-200">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Responsable de stage</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Nom</p>
                                <p class="text-base font-medium text-gray-900 mt-1">{{ convention.companyInfo.responsibleLastName|default('Non renseigné') }}</p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Prénom</p>
                                <p class="text-base font-medium text-gray-900 mt-1">{{ convention.companyInfo.responsibleFirstName|default('Non renseigné') }}</p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Fonction</p>
                                <p class="text-base font-medium text-gray-900 mt-1">{{ convention.companyInfo.responsibleFunction|default('Non renseignée') }}</p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Email</p>
                                <p class="text-base font-medium text-gray-900 mt-1">{{ convention.companyInfo.email|default('Non renseigné') }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Dates et sujet -->
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">Période et sujet</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Date de début</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.internshipStartDate %}
                                        {{ convention.companyInfo.internshipStartDate|date('d/m/Y') }}
                                    {% else %}
                                        <span class="text-gray-400">Non renseignée</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Date de fin</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if convention.companyInfo.internshipEndDate %}
                                        {{ convention.companyInfo.internshipEndDate|date('d/m/Y') }}
                                    {% else %}
                                        <span class="text-gray-400">Non renseignée</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="bg-yellow-50 rounded-lg border-l-4 border-yellow-400 p-4">
                    <p class="text-yellow-700">Aucune information de collecte disponible pour cette convention.</p>
                </div>
            {% endif %}

            <!-- Validation du professeur -->
            <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Validation du professeur</h2>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Professeur référent</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">
                            {% if convention.referentProfessor %}
                                {{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}
                            {% else %}
                                <span class="text-gray-400">Non assigné</span>
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Date de création</p>
                        <p class="text-lg font-medium text-gray-900 mt-1">
                            {% if convention.createdAt %}
                                {{ convention.createdAt|date('d/m/Y H:i') }}
                            {% else %}
                                <span class="text-gray-400">Non renseignée</span>
                            {% endif %}
                        </p>
                    </div>
                    {% if convention.validationNotes %}
                        <div class="col-span-2">
                            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Notes de validation</p>
                            <p class="text-base font-medium text-gray-900 mt-1">{{ convention.validationNotes }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Barre latérale - Actions -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6 sticky top-24">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Actions</h3>

                <div class="space-y-3">
                    <!-- Bouton Générer PDF -->
                    <a href="{{ path('admin_convention_generate_pdf', {'id': convention.id}) }}"
                       target="_blank"
                       class="block w-full px-4 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-center font-semibold no-underline">
                        <svg class="h-5 w-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                        Générer le PDF
                    </a>

                    <!-- Bouton Approuver -->
                    <form method="POST" action="{{ path('admin_convention_approve', {'id': convention.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('approve_' ~ convention.id) }}">
                        <button type="submit"
                                class="w-full px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold"
                                onclick="return confirm('Êtes-vous sûr de vouloir approuver cette convention ?')">
                            <svg class="h-5 w-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Valider et approuver
                        </button>
                    </form>

                    <!-- Bouton Refuser (Toggle) -->
                    <button type="button"
                            onclick="document.getElementById('refuse-form').classList.toggle('hidden')"
                            class="w-full px-4 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-semibold">
                        <svg class="h-5 w-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                        Refuser
                    </button>
                </div>

                <!-- Formulaire de refus (caché par défaut) -->
                <div id="refuse-form" class="hidden mt-4 p-4 bg-red-50 rounded-lg border border-red-200">
                    <form method="POST" action="{{ path('admin_convention_refuse', {'id': convention.id}) }}">
                        <div class="mb-4">
                            <label for="rejectionReason" class="block text-sm font-semibold text-gray-700 mb-2">
                                Raison du refus
                            </label>
                            <textarea id="rejectionReason"
                                      name="rejectionReason"
                                      rows="4"
                                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
                                      placeholder="Explicitez la raison du refus..."
                                      required></textarea>
                        </div>

                        <input type="hidden" name="_token" value="{{ csrf_token('refuse_' ~ convention.id) }}">

                        <div class="flex gap-2">
                            <button type="submit"
                                    class="flex-1 px-3 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-semibold text-sm"
                                    onclick="return confirm('Êtes-vous sûr de vouloir refuser cette convention ?')">
                                Confirmer le refus
                            </button>
                            <button type="button"
                                    onclick="document.getElementById('refuse-form').classList.toggle('hidden')"
                                    class="flex-1 px-3 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition font-semibold text-sm">
                                Annuler
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

