{% extends "base.html.twig" %}

{% block title %}Demandes en cours - Conventio {% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- En-tête -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Demandes en cours</h1>
        <p class="text-gray-600">Conventions validées par les professeurs en attente de validation</p>
    </div>

    <!-- Alertes de session -->
    {% for message in app.flashes('success') %}
        <div class="mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-700">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700">
            {{ message }}
        </div>
    {% endfor %}

    <!-- Contenu principal -->
    {% if groupedByFormation|length == 0 %}
        <div class="bg-gray-50 rounded-lg border border-gray-200 p-8 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Aucune demande</h3>
            <p class="text-gray-600">Aucune convention en cours de validation.</p>
        </div>
    {% else %}
        <!-- Groupé par formation -->
        <div class="space-y-6">
            {% for formationName, conventions in groupedByFormation %}
                <div class="bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden">
                    <!-- En-tête de formation -->
                    <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
                        <h2 class="text-xl font-bold text-white">{{ formationName }}</h2>
                        <p class="text-blue-100 text-sm">{{ conventions|length }} demande{{ conventions|length > 1 ? 's' : '' }}</p>
                    </div>

                    <!-- Liste des étudiants -->
                    <div class="divide-y divide-gray-200">
                        {% for convention in conventions %}
                            <div class="hover:bg-blue-50 transition duration-200">
                                <a href="{{ path('admin_convention_show', {'id': convention.id}) }}" class="block px-6 py-4 no-underline hover:no-underline">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="font-semibold text-gray-900">
                                                {{ convention.student.firstName }} {{ convention.student.lastName }}
                                            </p>
                                            <p class="text-sm text-gray-500 mt-1">
                                                <span class="inline-block">
                                                    {% if convention.companyInfo %}
                                                        {{ convention.companyInfo.companyName }}
                                                    {% else %}
                                                        <span class="text-gray-400">Entreprise non renseignée</span>
                                                    {% endif %}
                                                </span>
                                            </p>
                                            {% if convention.referentProfessor %}
                                                <p class="text-sm text-gray-500">
                                                    Professeur référent: <span class="font-medium">{{ convention.referentProfessor.firstName }} {{ convention.referentProfessor.lastName }}</span>
                                                </p>
                                            {% endif %}
                                        </div>
                                        <div class="text-right">
                                            <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                                En attente
                                            </span>
                                            <svg class="h-5 w-5 text-gray-400 ml-2 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                            </svg>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

