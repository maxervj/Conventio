{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - Conventio{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-purple-50 via-indigo-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">

        {# Header #}
        <div class="mb-8">
            <a href="{{ path('app_profile') }}" class="inline-flex items-center gap-2 text-sm font-medium text-purple-600 hover:text-purple-500 mb-5 group">
                <svg class="h-4 w-4 transition group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Retour au profil
            </a>

            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-extrabold text-gray-900">Modifier mon profil</h1>
                    <p class="text-sm text-gray-500 mt-0.5">Gérez vos classes et votre rôle de référent</p>
                </div>
            </div>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

        {# Classes enseignées — badges toggle multi-sélection #}
        <div class="rounded-xl border border-purple-200 overflow-hidden shadow-sm">
            <div class="bg-gradient-to-r from-purple-600 to-indigo-600 px-5 py-4 flex items-center gap-3">
                <svg class="w-5 h-5 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <div>
                    <p class="text-white font-semibold">Classes que vous enseignez</p>
                    <p class="text-purple-200 text-xs mt-0.5">Multi-sélection — cliquez pour sélectionner / désélectionner</p>
                </div>
            </div>

            <div class="bg-purple-50 p-5">
                {# Inputs Symfony cachés #}
                <div class="hidden">
                    {% for level in form.taughtLevels %}
                        {{ form_widget(level) }}
                    {% endfor %}
                </div>

                {# Badges toggle #}
                <div class="flex flex-wrap gap-2">
                    {% for level in form.taughtLevels %}
                        <label class="level-badge-prof cursor-pointer px-4 py-2 rounded-full border-2 text-sm font-medium transition-all duration-150 select-none flex items-center gap-2 {{ level.vars.checked ? 'border-purple-500 bg-purple-500 text-white shadow-md' : 'border-gray-300 bg-white text-gray-700 hover:border-purple-400 hover:text-purple-700' }}"
                               data-input-id="{{ level.vars.id }}">
                            <svg class="w-3.5 h-3.5 check-icon {{ level.vars.checked ? '' : 'hidden' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                            </svg>
                            {{ level.vars.label }}
                        </label>
                    {% endfor %}
                </div>

                {{ form_errors(form.taughtLevels) }}
            </div>
        </div>
        {% do form.taughtLevels.setRendered() %}

        {# Classe référente — select stylé #}
        <div class="rounded-xl border border-indigo-200 overflow-hidden shadow-sm">
            <div class="bg-gradient-to-r from-indigo-600 to-blue-600 px-5 py-4 flex items-center gap-3">
                <svg class="w-5 h-5 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
                <div>
                    <p class="text-white font-semibold">Classe référente</p>
                    <p class="text-indigo-200 text-xs mt-0.5">Optionnel — si vous êtes professeur référent d'une classe</p>
                </div>
            </div>

            <div class="bg-indigo-50 p-5">
                <div class="relative">
                    {{ form_widget(form.referentLevel, {
                        'attr': {
                            'class': 'block w-full pl-4 pr-10 py-3 border border-indigo-300 rounded-xl bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-800 appearance-none transition shadow-sm'
                        }
                    }) }}
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-indigo-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </div>
                </div>
                {{ form_errors(form.referentLevel) }}
            </div>
        </div>

        {# Boutons #}
        <div class="flex items-center justify-end gap-3 pt-2">
            <a href="{{ path('app_profile') }}"
               class="px-5 py-2.5 rounded-xl border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition duration-200">
                Annuler
            </a>
            <button type="submit"
                    class="px-6 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Enregistrer
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.level-badge-prof').forEach(function (badge) {
        badge.addEventListener('click', function () {
            const checkbox = document.getElementById(badge.dataset.inputId);
            if (!checkbox) return;

            checkbox.checked = !checkbox.checked;
            const checkIcon = badge.querySelector('.check-icon');

            if (checkbox.checked) {
                badge.classList.add('border-purple-500', 'bg-purple-500', 'text-white', 'shadow-md');
                badge.classList.remove('border-gray-300', 'bg-white', 'text-gray-700', 'hover:border-purple-400', 'hover:text-purple-700');
                if (checkIcon) checkIcon.classList.remove('hidden');
            } else {
                badge.classList.remove('border-purple-500', 'bg-purple-500', 'text-white', 'shadow-md');
                badge.classList.add('border-gray-300', 'bg-white', 'text-gray-700', 'hover:border-purple-400', 'hover:text-purple-700');
                if (checkIcon) checkIcon.classList.add('hidden');
            }
        });
    });
});
</script>
{% endblock %}
