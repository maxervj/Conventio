{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - Conventio{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">

        {# Header #}
        <div class="mb-8">
            <a href="{{ path('app_profile') }}" class="inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-500 mb-5 group">
                <svg class="h-4 w-4 transition group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Retour au profil
            </a>

            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-extrabold text-gray-900">Modifier mon profil</h1>
                    <p class="text-sm text-gray-500 mt-0.5">Mettez à jour votre classe BTS</p>
                </div>
            </div>
        </div>

        {{ form_start(form) }}

        {# Sélection de classe — cards radio #}
        <div class="rounded-xl border border-blue-200 overflow-hidden shadow-sm mb-6">
            <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-4 flex items-center gap-3">
                <svg class="w-5 h-5 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                <div>
                    <p class="text-white font-semibold">Votre classe BTS</p>
                    <p class="text-blue-200 text-xs mt-0.5">Sélection unique</p>
                </div>
            </div>

            <div class="bg-blue-50 p-5">
                {# Cards visuelles 2 colonnes — checkbox intégré dans le label #}
                <div class="grid grid-cols-2 gap-2">
                    {% for level in form.levels %}
                        <label class="level-card-student cursor-pointer rounded-xl border-2 bg-white p-3.5 flex items-center gap-3 hover:border-blue-400 hover:shadow-md transition-all duration-150 select-none {{ level.vars.checked ? 'border-blue-500 bg-blue-50 shadow-md ring-2 ring-blue-200' : 'border-gray-200' }}">
                            {{ form_widget(level, {'attr': {'class': 'sr-only'}}) }}
                            <div class="level-radio-dot flex-shrink-0 w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all {{ level.vars.checked ? 'border-blue-500 bg-blue-500' : 'border-gray-300' }}">
                                <div class="w-2 h-2 rounded-full bg-white radio-inner-dot {{ level.vars.checked ? '' : 'hidden' }}"></div>
                            </div>
                            <span class="text-sm font-medium text-gray-800 leading-snug">{{ level.vars.label }}</span>
                        </label>
                    {% endfor %}
                </div>

                {{ form_errors(form.level) }}
            </div>
        </div>
        {% do form.level.setRendered() %}

        {# Boutons #}
        <div class="flex items-center justify-end gap-3">
            <a href="{{ path('app_profile') }}"
               class="px-5 py-2.5 rounded-xl border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition duration-200">
                Annuler
            </a>
            <button type="submit"
                    class="px-6 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-md hover:shadow-lg transition-all duration-200 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Enregistrer
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.level-card-student').forEach(function (card) {
        card.addEventListener('click', function (e) {
            e.preventDefault();
            const checkbox = card.querySelector('input[type="checkbox"]');
            if (!checkbox) return;

            document.querySelectorAll('.level-card-student').forEach(function (c) {
                const other = c.querySelector('input[type="checkbox"]');
                if (other) other.checked = false;
                c.classList.remove('border-blue-500', 'bg-blue-50', 'shadow-md', 'ring-2', 'ring-blue-200');
                c.classList.add('border-gray-200');
                const dot = c.querySelector('.level-radio-dot');
                const inner = c.querySelector('.radio-inner-dot');
                if (dot) { dot.classList.remove('border-blue-500', 'bg-blue-500'); dot.classList.add('border-gray-300'); }
                if (inner) inner.classList.add('hidden');
            });

            checkbox.checked = true;
            card.classList.add('border-blue-500', 'bg-blue-50', 'shadow-md', 'ring-2', 'ring-blue-200');
            card.classList.remove('border-gray-200');
            const dot = card.querySelector('.level-radio-dot');
            const inner = card.querySelector('.radio-inner-dot');
            if (dot) { dot.classList.add('border-blue-500', 'bg-blue-500'); dot.classList.remove('border-gray-300'); }
            if (inner) inner.classList.remove('hidden');
        });
    });
});
</script>
{% endblock %}
