{% extends 'base.html.twig' %}

{% block title %}{{ 'company_info.title'|trans }} - Lecture seule{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 py-8">
        <!-- Language Selector -->
        <div class="max-w-5xl mx-auto px-4 mb-4">
            <div class="flex justify-between items-center">
                <a href="javascript:history.back()" class="text-blue-600 hover:text-blue-700 font-medium">← Retour</a>
                <select id="language-select" onchange="changeLanguage(this.value)"
                        class="px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white">
                    <option value="fr" {{ locale == 'fr' ? 'selected' : '' }}>🇫🇷 Français</option>
                    <option value="en" {{ locale == 'en' ? 'selected' : '' }}>🇬🇧 English</option>
                    <option value="es" {{ locale == 'es' ? 'selected' : '' }}>🇪🇸 Español</option>
                    <option value="it" {{ locale == 'it' ? 'selected' : '' }}>🇮🇹 Italiano</option>
                    <option value="de" {{ locale == 'de' ? 'selected' : '' }}>🇩🇪 Deutsch</option>
                </select>
            </div>
        </div>

        <div class="max-w-5xl mx-auto px-4">
            <!-- Header Card -->
            <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-gray-100">
                <div class="text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full mb-4">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <h1 class="text-3xl font-bold text-gray-900 mb-2">{{ 'company_info.title'|trans }}</h1>
                    <p class="text-gray-600 font-semibold text-lg">📖 Consultation - Lecture seule</p>
                </div>
            </div>

            {# Organization Information #}
            <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200 mb-8">
                <div class="flex items-center mb-6 pb-4 border-b border-gray-200">
                    <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900">{{ 'company_info.organization_info'|trans }}</h3>
                </div>

                <div class="grid grid-cols-1 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nom de l'entreprise</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.companyName ?? '-' }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Adresse</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.address ?? '-' }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Complément d'adresse</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.addressComplement ?? '-' }}
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Code postal</label>
                            <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                                {{ companyInfo.postalCode ?? '-' }}
                            </div>
                        </div>
                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Ville</label>
                            <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                                {{ companyInfo.city ?? '-' }}
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Pays</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.country ?? '-' }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Numéro SIRET</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.siret ?? '-' }}
                        </div>
                    </div>
                </div>
            </div>

            {# Responsible Information #}
            <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200 mb-8">
                <div class="flex items-center mb-6 pb-4 border-b border-gray-200">
                    <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900">👤 Responsable de stage (Maître de stage)</h3>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.responsibleLastName ?? '-' }}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Prénom</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.responsibleFirstName ?? '-' }}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Fonction</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.responsibleFunction ?? '-' }}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {% if companyInfo.email %}
                                <a href="mailto:{{ companyInfo.email }}" class="text-blue-600 hover:text-blue-700">
                                    {{ companyInfo.email }}
                                </a>
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# Contact Information #}
            <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200 mb-8">
                <div class="flex items-center mb-6 pb-4 border-b border-gray-200">
                    <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900">📞 Coordonnées de contact</h3>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone fixe</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.landlinePhone ?? '-' }}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone mobile</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-900">
                            {{ companyInfo.mobilePhone ?? '-' }}
                        </div>
                    </div>
                </div>
            </div>

            {# Internship Details #}
            <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200 mb-8">
                <div class="flex items-center mb-6 pb-4 border-b border-gray-200">
                    <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900">📅 Période de stage</h3>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date de début</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-blue-50 text-gray-900 font-medium">
                            {% if companyInfo.internshipStartDate %}
                                {{ companyInfo.internshipStartDate|date('d/m/Y') }}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date de fin</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-blue-50 text-gray-900 font-medium">
                            {% if companyInfo.internshipEndDate %}
                                {{ companyInfo.internshipEndDate|date('d/m/Y') }}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# Activities #}
            {% if companyInfo.plannedActivities %}
                <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200 mb-8">
                    <div class="flex items-center mb-6 pb-4 border-b border-gray-200">
                        <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mr-3">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-900">📝 Activités professionnelles prévues</h3>
                    </div>

                    <div>
                        <div class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-900 whitespace-pre-wrap">
                            {{ companyInfo.plannedActivities }}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Other Information #}
            <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-200 mb-8">
                <div class="flex items-center mb-6 pb-4 border-b border-gray-200">
                    <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900">ℹ️ Informations supplémentaires</h3>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Déplacements</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50">
                            {% if companyInfo.hasTravel %}
                                <span class="inline-block px-3 py-1 bg-orange-100 text-orange-800 rounded font-medium">Oui</span>
                            {% else %}
                                <span class="text-gray-600">Non</span>
                            {% endif %}
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Gratification</label>
                        <div class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50">
                            {% if companyInfo.providesGratification %}
                                <span class="inline-block px-3 py-1 bg-green-100 text-green-800 rounded font-medium">Oui</span>
                            {% else %}
                                <span class="text-gray-600">Non</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {% if companyInfo.workSchedule %}
                    <div class="mt-6 pt-6 border-t border-gray-200">
                        <label class="block text-sm font-medium text-gray-700 mb-3">Horaires de travail</label>
                        <div class="overflow-x-auto">
                            <table class="min-w-full border border-gray-200 rounded-lg">
                                <thead>
                                    <tr class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white">
                                        <th class="px-4 py-3 text-left text-sm font-semibold">Jour</th>
                                        <th class="px-4 py-3 text-center text-sm font-semibold">Matin</th>
                                        <th class="px-4 py-3 text-center text-sm font-semibold">Après-midi</th>
                                        <th class="px-4 py-3 text-center text-sm font-semibold">Total</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    {% set days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'] %}
                                    {% set weeklyTotalMinutes = 0 %}
                                    {% for day in days %}
                                        {% set schedule = companyInfo.workSchedule[day] ?? null %}
                                        {% if schedule %}
                                            {% set totalStr = schedule.total|default('0:00') %}
                                            {% set totalParts = totalStr|split(':') %}
                                            {% set dayMinutes = ((totalParts[0]|default(0) * 1)|round) * 60 + ((totalParts[1]|default(0) * 1)|round) %}
                                            {% set weeklyTotalMinutes = weeklyTotalMinutes + dayMinutes %}
                                            <tr class="hover:bg-gray-50 transition">
                                                <td class="px-4 py-3 font-medium text-gray-900">{{ ('company_info.' ~ day)|trans }}</td>
                                                <td class="px-4 py-3 text-center text-gray-700">
                                                    {{ '%02d'|format(schedule.morning_start_h|default(0)) }}:{{ '%02d'|format(schedule.morning_start_m|default(0)) }} - {{ '%02d'|format(schedule.morning_end_h|default(0)) }}:{{ '%02d'|format(schedule.morning_end_m|default(0)) }}
                                                </td>
                                                <td class="px-4 py-3 text-center text-gray-700">
                                                    {{ '%02d'|format(schedule.afternoon_start_h|default(0)) }}:{{ '%02d'|format(schedule.afternoon_start_m|default(0)) }} - {{ '%02d'|format(schedule.afternoon_end_h|default(0)) }}:{{ '%02d'|format(schedule.afternoon_end_m|default(0)) }}
                                                </td>
                                                <td class="px-4 py-3 text-center font-semibold text-blue-600">{{ schedule.total|default('0:00') }}</td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                    <tr class="bg-blue-50 font-semibold">
                                        <td colspan="3" class="px-4 py-3 text-right text-gray-900">Total hebdomadaire</td>
                                        <td class="px-4 py-3 text-center text-blue-700 text-lg">
                                            {% set weeklyHours = (weeklyTotalMinutes / 60)|round(0, 'floor') %}
                                            {% set weeklyMinutes = weeklyTotalMinutes - (weeklyHours * 60) %}
                                            {{ weeklyHours }}:{{ '%02d'|format(weeklyMinutes) }}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
            </div>

            {# Footer #}
            <div class="bg-gray-50 rounded-xl p-4 border border-gray-200 text-center text-sm text-gray-600 mb-8">
                {% if companyInfo.completedAt %}
                    <p>✓ Formulaire complété le <strong>{{ companyInfo.completedAt|date('d/m/Y à H:i') }}</strong></p>
                {% endif %}
                <p class="mt-2">Cette page est en lecture seule. Aucune modification ne peut être effectuée.</p>
            </div>
        </div>
    </div>

    <script>
        function changeLanguage(lang) {
            const params = new URLSearchParams(window.location.search);
            params.set('lang', lang);
            window.location.href = window.location.pathname + '?' + params.toString();
        }
    </script>
{% endblock %}





