{% extends 'base.html.twig' %}

{% block title %}Demande envoyée avec succès - Conventio{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 flex items-center justify-center px-4 py-12">
    <div class="max-w-2xl w-full">

        {# Icône animée #}
        <div class="flex justify-center mb-8">
            <div class="relative">
                <div class="w-32 h-32 bg-gradient-to-br from-green-400 to-emerald-600 rounded-full flex items-center justify-center shadow-2xl animate-pulse">
                    <svg class="w-20 h-20 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <div class="absolute -top-2 -right-2 w-10 h-10 bg-yellow-400 rounded-full flex items-center justify-center shadow-lg">
                    <svg class="w-6 h-6 text-yellow-900" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                </div>
            </div>
        </div>

        {# Carte principale #}
        <div class="bg-white rounded-3xl shadow-2xl p-10 text-center border border-green-100">

            <h1 class="text-4xl font-extrabold text-gray-900 mb-4">
                Demande envoyée !
            </h1>

            <p class="text-xl text-gray-600 mb-6 leading-relaxed">
                Votre demande de collecte d'informations a été envoyée avec succès
                {% if contactEmail %}
                    à <span class="font-semibold text-green-700">{{ contactEmail }}</span>
                {% endif %}.
            </p>

            <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-8 text-left">
                <h2 class="font-bold text-green-900 text-lg mb-3 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Prochaines étapes
                </h2>
                <ul class="space-y-2 text-green-800 text-sm">
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-green-600 mt-0.5">1.</span>
                        L'entreprise reçoit un email avec un lien sécurisé pour remplir ses informations.
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-green-600 mt-0.5">2.</span>
                        Vous serez notifié par email dès que l'entreprise aura complété le formulaire.
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="font-bold text-green-600 mt-0.5">3.</span>
                        Vous pourrez suivre l'état de vos demandes dans "Mes demandes".
                    </li>
                </ul>
            </div>

            {# Barre de progression de la redirection #}
            <p class="text-gray-400 text-sm mb-4">
                Redirection vers l'accueil dans <span id="countdown" class="font-bold text-green-600">10</span> secondes...
            </p>
            <div class="w-full bg-gray-200 rounded-full h-2 mb-6">
                <div id="progress-bar" class="bg-gradient-to-r from-green-400 to-emerald-600 h-2 rounded-full transition-all duration-[10000ms]" style="width: 0%"></div>
            </div>

            {# Boutons #}
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <a href="{{ path('app_home') }}" class="px-8 py-3 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-semibold rounded-xl shadow-lg hover:from-green-600 hover:to-emerald-700 transition duration-200 flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    Aller à l'accueil
                </a>
                <a href="{{ path('student_my_requests') }}" class="px-8 py-3 bg-white border-2 border-green-300 text-green-700 font-semibold rounded-xl hover:bg-green-50 transition duration-200 flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    Voir mes demandes
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    const homeUrl = "{{ path('app_home') }}";
    let seconds = 10;
    const countdown = document.getElementById('countdown');
    const progressBar = document.getElementById('progress-bar');

    // Démarre la barre de progression immédiatement
    setTimeout(() => { progressBar.style.width = '100%'; }, 100);

    const timer = setInterval(() => {
        seconds--;
        countdown.textContent = seconds;
        if (seconds <= 0) {
            clearInterval(timer);
            window.location.href = homeUrl;
        }
    }, 1000);
</script>
{% endblock %}
