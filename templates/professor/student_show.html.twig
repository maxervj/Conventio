{% extends 'base.html.twig' %}

{% block title %}{{ student.firstName }} {{ student.lastName }} — Conventio{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <!-- Back link -->
        <a href="{{ path('professor_my_students') }}" class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 hover:text-indigo-500 mb-6 group">
            <svg class="h-4 w-4 transition group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour à mes étudiants
        </a>

        <!-- Flash messages -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-lg {% if type == 'success' %}bg-green-50 border border-green-200 text-green-800{% elseif type == 'error' %}bg-red-50 border border-red-200 text-red-800{% else %}bg-blue-50 border border-blue-200 text-blue-800{% endif %} p-4">
                    <p class="text-sm font-medium">{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Header Card -->
        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl shadow-lg overflow-hidden mb-8">
            <div class="px-6 py-8">
                <div class="flex items-center">
                    <div class="h-20 w-20 rounded-full bg-white/20 flex items-center justify-center text-4xl font-bold text-white ring-4 ring-white/30">
                        {{ student.firstName|first }}{{ student.lastName|first }}
                    </div>
                    <div class="ml-6">
                        <h1 class="text-3xl font-bold text-white">{{ student.firstName }} {{ student.lastName }}</h1>
                        <p class="text-indigo-100 mt-1">Étudiant</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column - Main Info -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Informations Personnelles -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-4 bg-gradient-to-r from-blue-50 to-indigo-50 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-900">Informations personnelles</h2>
                    </div>
                    <div class="px-6 py-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Prénom</p>
                                <p class="text-lg font-medium text-gray-900 mt-1">{{ student.firstName }}</p>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Nom</p>
                                <p class="text-lg font-medium text-gray-900 mt-1">{{ student.lastName }}</p>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Email professionnel</p>
                                <p class="text-sm text-gray-700 mt-1">
                                    <a href="mailto:{{ student.email }}" class="text-indigo-600 hover:text-indigo-700">{{ student.email }}</a>
                                </p>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Email personnel</p>
                                <p class="text-sm text-gray-700 mt-1">
                                    {% if student.personalEmail %}
                                        <a href="mailto:{{ student.personalEmail }}" class="text-indigo-600 hover:text-indigo-700">{{ student.personalEmail }}</a>
                                    {% else %}
                                        <span class="text-gray-400">Non renseigné</span>
                                    {% endif %}
                                </p>
                            </div>
                            {% if student.birthDate %}
                                <div>
                                    <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Date de naissance</p>
                                    <p class="text-sm text-gray-700 mt-1">{{ student.birthDate|date('d/m/Y') }}</p>
                                </div>
                            {% endif %}
                            {% if student.contractStartDate %}
                                <div>
                                    <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Début du contrat</p>
                                    <p class="text-sm text-gray-700 mt-1">{{ student.contractStartDate|date('d/m/Y') }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Formation -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-4 bg-gradient-to-r from-purple-50 to-pink-50 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-900">Formation</h2>
                    </div>
                    <div class="px-6 py-6">
                        {% if student.formation %}
                            <div>
                                <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Formation</p>
                                <p class="text-lg font-medium text-gray-900 mt-2">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                                        {{ student.formation.libelle }}
                                    </span>
                                </p>
                                {% if student.formation.code %}
                                    <p class="text-xs text-gray-500 mt-2">Code: {{ student.formation.code }}</p>
                                {% endif %}
                            </div>
                        {% else %}
                            <p class="text-gray-500">Aucune formation assignée</p>
                        {% endif %}
                    </div>
                </div>

                <!-- Niveaux -->
                {% if student.levels|length > 0 %}
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 bg-gradient-to-r from-green-50 to-emerald-50 border-b border-gray-200">
                            <h2 class="text-lg font-semibold text-gray-900">Niveaux et Classes</h2>
                        </div>
                        <div class="px-6 py-6">
                            <div class="flex flex-wrap gap-2">
                                {% for level in student.levels %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                        {{ level.levelName }}
                                    </span>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>

            <!-- Right Column - Actions -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Status Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-4 bg-gradient-to-r from-amber-50 to-orange-50 border-b border-gray-200">
                        <h3 class="text-sm font-semibold text-gray-900">Statut</h3>
                    </div>
                    <div class="px-6 py-6">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                            ✓ Actif
                        </span>
                    </div>
                </div>

                <!-- Actions Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-4 bg-gradient-to-r from-indigo-50 to-purple-50 border-b border-gray-200">
                        <h3 class="text-sm font-semibold text-gray-900">Actions</h3>
                    </div>
                    <div class="px-6 py-6 space-y-3">
                        <a href="mailto:{{ student.email }}" class="flex items-center justify-center w-full px-4 py-2 border border-indigo-200 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors font-medium text-sm gap-2">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                            Envoyer un email
                        </a>

                        <button class="flex items-center justify-center w-full px-4 py-2 bg-indigo-600 text-white hover:bg-indigo-700 rounded-lg transition-colors font-medium text-sm gap-2" onclick="alert('À implémenter: Voir les conventions de cet étudiant')">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            Voir les conventions
                        </button>
                    </div>
                </div>

                <!-- Info Card -->
                <div class="bg-blue-50 rounded-2xl border border-blue-200 p-4">
                    <p class="text-sm text-blue-800">
                        <strong>Astuce:</strong> Vous pouvez envoyer des emails directement à cet étudiant en cliquant sur "Envoyer un email".
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

