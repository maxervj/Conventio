{% extends 'base.html.twig' %}

{% block title %}Collectes — Conventio{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-purple-50 via-indigo-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">

        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-gray-900">Collectes d'informations</h1>
            <p class="mt-1 text-sm text-gray-500">Collectes soumises par les étudiants de vos classes</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 p-4 rounded-xl border-l-4 {{ label == 'error' ? 'bg-red-50 border-red-500 text-red-700' : 'bg-green-50 border-green-500 text-green-700' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if collectes|length == 0 %}
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center">
                <div class="mx-auto w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-1">Aucune collecte</h3>
                <p class="text-sm text-gray-500">Aucun étudiant de vos classes n'a encore soumis de collecte.</p>
            </div>
        {% else %}
            <div class="space-y-4">
                {% for collecte in collectes %}
                    <a href="{{ path('professor_collecte_show', {id: collecte.id}) }}"
                       class="block bg-white rounded-2xl shadow-sm border border-gray-100 p-5 hover:shadow-md hover:border-purple-200 transition-all duration-200 group">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-purple-100 to-indigo-100 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-900 group-hover:text-purple-700 transition-colors">
                                        {{ collecte.companyName }}
                                    </p>
                                    <p class="text-xs text-gray-500 mt-0.5">
                                        {{ collecte.student.firstName }} {{ collecte.student.lastName }} ·
                                        Envoyée le {{ collecte.createdAt|date('d/m/Y') }}
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                {% if collecte.isCompleted() %}
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">Complétée</span>
                                {% else %}
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">En attente</span>
                                {% endif %}
                                <svg class="w-4 h-4 text-gray-400 group-hover:text-purple-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
