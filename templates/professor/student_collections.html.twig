{% extends "base.html.twig" %}

{% block title %}Collectes de {{ student.firstName }} {{ student.lastName }} - Conventio {% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Retour -->
    <div class="mb-6">
        <a href="{{ path('professor_student_show', {'id': student.id}) }}" class="inline-flex items-center text-blue-600 hover:text-blue-700 transition">
            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Retour au profil de l'étudiant
        </a>
    </div>

    <!-- En-tête -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">
            Collectes de {{ student.firstName }} {{ student.lastName }}
        </h1>
        <p class="text-gray-600">
            Consultez les collectes d'informations complétées par cet étudiant pour ses conventions de stage.
        </p>
    </div>

    <!-- Alertes -->
    {% for message in app.flashes('success') %}
        <div class="mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-700 rounded">
            <div class="flex items-center">
                <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                </svg>
                {{ message }}
            </div>
        </div>
    {% endfor %}

    <!-- Contenu principal -->
    {% if collections|length == 0 %}
        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-12 text-center">
            <svg class="h-12 w-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Aucune collecte disponible</h3>
            <p class="text-gray-600">
                {{ student.firstName }} n'a pas encore complété de collecte d'informations.
            </p>
        </div>
    {% else %}
        <div class="grid gap-6">
            {% for collection in collections %}
                <div class="bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
                    <!-- En-tête de la collecte -->
                    <div class="px-6 py-4 bg-gradient-to-r from-green-50 to-emerald-50 border-b border-gray-200">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="h-10 w-10 rounded-full bg-green-100 flex items-center justify-center">
                                    <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900">{{ collection.companyName }}</h3>
                                    <p class="text-sm text-gray-600">
                                        Complétée le {{ collection.completedAt|date('d/m/Y à H:i') }}
                                    </p>
                                </div>
                            </div>
                            <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                ✓ Complétée
                            </span>
                        </div>
                    </div>

                    <!-- Contenu de la collecte -->
                    <div class="px-6 py-6 space-y-6">
                        <!-- Informations de l'entreprise -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Entreprise</p>
                                <p class="text-base font-medium text-gray-900 mt-1">{{ collection.companyName }}</p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">SIRET</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if collection.siret %}
                                        {{ collection.siret }}
                                    {% else %}
                                        <span class="text-gray-400">Non renseigné</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div class="lg:col-span-2">
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Adresse</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if collection.address %}
                                        {{ collection.address }}
                                        {% if collection.addressComplement %}<br>{{ collection.addressComplement }}{% endif %}
                                        <br>{{ collection.postalCode }} {{ collection.city }}
                                        {% if collection.country %}<br>{{ collection.country }}{% endif %}
                                    {% else %}
                                        <span class="text-gray-400">Non renseignée</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        <!-- Responsable de stage -->
                        <div class="border-t pt-6">
                            <h4 class="text-lg font-semibold text-gray-900 mb-4">👤 Responsable de stage</h4>
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Nom</p>
                                    <p class="text-base font-medium text-gray-900 mt-1">
                                        {{ collection.responsibleLastName|default('Non renseigné') }}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Prénom</p>
                                    <p class="text-base font-medium text-gray-900 mt-1">
                                        {{ collection.responsibleFirstName|default('Non renseigné') }}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Fonction</p>
                                    <p class="text-base font-medium text-gray-900 mt-1">
                                        {{ collection.responsibleFunction|default('Non renseignée') }}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Email</p>
                                    <p class="text-base font-medium text-gray-900 mt-1">
                                        {% if collection.email %}
                                            <a href="mailto:{{ collection.email }}" class="text-blue-600 hover:text-blue-700">
                                                {{ collection.email }}
                                            </a>
                                        {% else %}
                                            <span class="text-gray-400">Non renseigné</span>
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Période de stage -->
                        <div class="border-t pt-6">
                            <h4 class="text-lg font-semibold text-gray-900 mb-4">📅 Période de stage</h4>
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Date de début</p>
                                    <p class="text-base font-medium text-gray-900 mt-1">
                                        {% if collection.internshipStartDate %}
                                            <span class="inline-block px-3 py-1 bg-blue-50 text-blue-900 rounded">
                                                {{ collection.internshipStartDate|date('d/m/Y') }}
                                            </span>
                                        {% else %}
                                            <span class="text-gray-400">Non renseignée</span>
                                        {% endif %}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Date de fin</p>
                                    <p class="text-base font-medium text-gray-900 mt-1">
                                        {% if collection.internshipEndDate %}
                                            <span class="inline-block px-3 py-1 bg-blue-50 text-blue-900 rounded">
                                                {{ collection.internshipEndDate|date('d/m/Y') }}
                                            </span>
                                        {% else %}
                                            <span class="text-gray-400">Non renseignée</span>
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Activités professionnelles prévues -->
                        {% if collection.plannedActivities %}
                            <div class="border-t pt-6">
                                <h4 class="text-lg font-semibold text-gray-900 mb-4">📝 Activités professionnelles prévues</h4>
                                <div>
                                    <p class="text-base font-medium text-gray-900 bg-gray-50 p-4 rounded-lg">
                                        {{ collection.plannedActivities }}
                                    </p>
                                </div>
                            </div>
                        {% endif %}

                        <!-- Autres informations -->
                        <div class="border-t pt-6 grid grid-cols-1 lg:grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Déplacements</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if collection.hasTravel %}
                                        <span class="inline-block px-3 py-1 bg-orange-100 text-orange-800 rounded">Oui</span>
                                    {% else %}
                                        <span class="text-gray-600">Non</span>
                                    {% endif %}
                                </p>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Gratification</p>
                                <p class="text-base font-medium text-gray-900 mt-1">
                                    {% if collection.providesGratification %}
                                        <span class="inline-block px-3 py-1 bg-green-100 text-green-800 rounded">Oui</span>
                                    {% else %}
                                        <span class="text-gray-600">Non</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Footer de la collecte -->
                    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
                        <p class="text-sm text-gray-600">
                            Créée le {{ collection.createdAt|date('d/m/Y à H:i') }}
                        </p>
                        <a href="{{ path('company_info_view', {'token': collection.token}) }}"
                           class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-sm font-medium no-underline"
                           target="_blank">
                            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                            Voir la collecte complète
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

