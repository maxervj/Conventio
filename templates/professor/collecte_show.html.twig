{% extends 'base.html.twig' %}

{% block title %}Détail collecte — Conventio{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-purple-50 via-indigo-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">

        <a href="{{ path('professor_collectes') }}" class="inline-flex items-center gap-2 text-sm font-medium text-purple-600 hover:text-purple-500 mb-6 group">
            <svg class="h-4 w-4 transition group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour aux collectes
        </a>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 p-4 rounded-xl border-l-4 {{ label == 'error' ? 'bg-red-50 border-red-500 text-red-700' : 'bg-green-50 border-green-500 text-green-700' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Bloc action selon statut de la convention #}
        {% if convention %}
            {% if isReferentProfessor and convention.isPendingValidation() %}
                <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5 mb-6 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-semibold text-blue-800">Sujet en attente de votre validation</p>
                        <p class="text-xs text-blue-600 mt-0.5">Vous êtes le professeur référent de cet étudiant. Vous pouvez valider ce sujet de stage.</p>
                    </div>
                    <form method="POST" action="{{ path('professor_collecte_validate_convention', {id: companyInfo.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('validate_convention_' ~ companyInfo.id) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 shadow-md transition-all duration-200 whitespace-nowrap">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                            </svg>
                            Valider le sujet
                        </button>
                    </form>
                </div>
            {% elseif convention.isValidated() or convention.isSigned() %}
                <div class="bg-green-50 border border-green-200 rounded-2xl p-4 mb-6 flex items-center gap-3">
                    <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <p class="text-sm font-semibold text-green-800">Sujet validé</p>
                </div>
            {% endif %}
        {% else %}
            {# Aucune convention n'existe encore - afficher le bouton pour en créer une #}
            {% if companyInfo.isCompleted() %}
                <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5 mb-6 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-semibold text-blue-800">Collecte complétée</p>
                        <p class="text-xs text-blue-600 mt-0.5">Créez et validez la convention pour cet étudiant.</p>
                    </div>
                    <form method="POST" action="{{ path('professor_collecte_create_convention', {id: companyInfo.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('create_convention_' ~ companyInfo.id) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 shadow-md transition-all duration-200 whitespace-nowrap">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                            Créer la convention
                        </button>
                    </form>
                </div>
            {% endif %}
        {% endif %}

        {# En-tête #}
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
            <div class="flex items-start gap-4">
                <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg flex-shrink-0">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-extrabold text-gray-900">{{ companyInfo.companyName }}</h1>
                    <p class="text-sm text-gray-500 mt-0.5">
                        Étudiant : <strong>{{ companyInfo.student.firstName }} {{ companyInfo.student.lastName }}</strong>
                        · Envoyée le {{ companyInfo.createdAt|date('d/m/Y') }}
                    </p>
                </div>
            </div>
        </div>

        {# Informations entreprise #}
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
            <h2 class="text-sm font-bold text-gray-700 mb-4">Informations de l'entreprise</h2>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {% if companyInfo.contactName %}
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Contact</dt>
                        <dd class="mt-0.5 text-sm text-gray-900">{{ companyInfo.contactName }}</dd>
                    </div>
                {% endif %}
                {% if companyInfo.contactEmail %}
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Email contact</dt>
                        <dd class="mt-0.5 text-sm text-gray-900">{{ companyInfo.contactEmail }}</dd>
                    </div>
                {% endif %}
                {% if companyInfo.address %}
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Adresse</dt>
                        <dd class="mt-0.5 text-sm text-gray-900">{{ companyInfo.address }}</dd>
                    </div>
                {% endif %}
                {% if companyInfo.city %}
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Ville</dt>
                        <dd class="mt-0.5 text-sm text-gray-900">{{ companyInfo.city }}{% if companyInfo.country %}, {{ companyInfo.country }}{% endif %}</dd>
                    </div>
                {% endif %}
                {% if companyInfo.internshipStartDate %}
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Début du stage</dt>
                        <dd class="mt-0.5 text-sm text-gray-900">{{ companyInfo.internshipStartDate|date('d/m/Y') }}</dd>
                    </div>
                {% endif %}
                {% if companyInfo.internshipEndDate %}
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Fin du stage</dt>
                        <dd class="mt-0.5 text-sm text-gray-900">{{ companyInfo.internshipEndDate|date('d/m/Y') }}</dd>
                    </div>
                {% endif %}
                {% if companyInfo.supervisorLastName %}
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Maître de stage</dt>
                        <dd class="mt-0.5 text-sm text-gray-900">{{ companyInfo.supervisorFirstName }} {{ companyInfo.supervisorLastName }}</dd>
                    </div>
                {% endif %}
                {% if companyInfo.supervisorFunction %}
                    <div>
                        <dt class="text-xs font-medium text-gray-400">Fonction</dt>
                        <dd class="mt-0.5 text-sm text-gray-900">{{ companyInfo.supervisorFunction }}</dd>
                    </div>
                {% endif %}
            </dl>
            {% if companyInfo.plannedActivities %}
                <div class="mt-4 pt-4 border-t border-gray-100">
                    <dt class="text-xs font-medium text-gray-400 mb-1">Activités prévues</dt>
                    <dd class="text-sm text-gray-700 leading-relaxed">{{ companyInfo.plannedActivities|nl2br }}</dd>
                </div>
            {% endif %}
        </div>

        {# Lien vers la convention #}
        {% if convention %}
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                <p class="text-sm text-gray-500 mb-2">Convention liée :</p>
                <a href="{{ path('convention_show', {id: convention.id}) }}"
                   class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 hover:text-indigo-500">
                    Voir la convention →
                </a>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
